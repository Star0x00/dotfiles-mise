// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "dap": {
    "Delve": {
      "enable_auto_updates": true,
      "allow_binary_download": true
    }
  },
  "node": {
    "allow_npm_install": true,
    "allow_binary_download": true
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"]
    }
  },
  "lsp": {
    "basedpyright": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "ruff": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "bash-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "tombi": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "clangd": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "nil": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "package-version-server": {
      "binary": {
        "ignore_system_version": true,
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "json-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    }
  },
  "ssh_connections": [
    {
      "host": "10.10.10.1",
      "username": "cyrene",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/cyrene"
          ]
        },
        {
          "paths": [
            "/home/cyrene/nixos-router"
          ]
        }
      ]
    }
  ],
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "active_pane_modifiers": {
    "border_size": -3.0,
    "inactive_opacity": 1.0
  },
  "window_decorations": "server",
  "use_system_window_tabs": false,
  "tabs": {
    "file_icons": true
  },
  "inlay_hints": {
    "enabled": true
  },
  "ui_font_family": "WenYuan Sans SC Flex VF",
  "buffer_font_family": "Iosevka Star",
  "buffer_font_fallbacks": ["LXGW WenKai Mono GB Screen"],
  "project_panel": {
    "file_icons": true,
    "folder_icons": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Gram (Default)",
    "dark": "Catppuccin Frappé"
  },
  "vim_mode": true,
  "ui_font_size": 20.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "dark",
    "light": "Zedokai Light",
    "dark": "Catppuccin Mocha",
  },
}
