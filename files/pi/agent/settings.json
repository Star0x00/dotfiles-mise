{
  "lastChangelogVersion": "1.6.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "low",
  "packages": [
    "npm:pi-tidy",
    "npm:@quandev104/pi-style"
  ],
  "tidy": {
    "collapseTurns": "off",
    "style": "frame",
    "bashResultLines": 3
  },
  "piStyle": {
    "preset": "default",
    "placement": "below",
    "startup": {
      "mode": "compact",
      "showResources": false
    },
    "statusLine": {
      "layout": {
        "left": [
          "path",
          "git",
          "context_bar",
          "cost"
        ],
        "right": [
          "model_effort"
        ],
        "secondary": [
          "extension_statuses"
        ]
      },
      "contextBarWidth": 10,
      "bottomMargin": 1
    },
    "editor": {
      "style": "dock",
      "frame": "rounded",
      "showMetadata": false
    },
    "messages": {
      "previewMaxWidth": 40,
      "mergedTurnSummary": true,
      "preserveCompactionTranscript": true
    },
    "tools": {
      "style": "compact-box",
      "maxCollapsedLines": 12,
      "maxExpandedLines": 60
    },
    "theme": {
      "autoApply": "catppuccin-mocha"
    }
  },
  "showHardwareCursor": true,
  "tuiMode": "fullscreen",
  "terminal": {
    "imageWidthCells": 100
  },
  "theme": "catppuccin-mocha",
  "hideThinkingBlock": true,
  "treeFilterMode": "default",
  "quietStartup": false,
  "cacheWarming": "streaming",
  "editorPaddingX": 0,
  "autocompleteMaxVisible": 5,
  "images": {
    "autoResize": true
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-tidy\",\"scope\":\"user\"}": "0.11.1",
    "{\"source\":\"npm:@quandev104/pi-style\",\"scope\":\"user\"}": "0.5.18"
  }
}
