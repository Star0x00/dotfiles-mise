// Tokyo Night Theme for Niri

layout {
    focus-ring {
        // Active: Blue
        active-color   "#7aa2f7"
        // Inactive: Base background
        inactive-color "#1a1b26"
        // Urgent: Red
        urgent-color   "#f7768e"
    }

    border {
        active-color   "#7aa2f7"
        inactive-color "#1a1b26"
        urgent-color   "#f7768e"
    }

    shadow {
        // 用比 Base 更深的暗色做阴影，保持蓝调
        color "#16161e99"
        // 非活动窗口更淡，靠浓淡区分焦点
        inactive-color "#16161e55"
    }

    tab-indicator {
        active-color   "#7aa2f7"
        // Inactive Tab: 使用较柔和的表面层颜色
        inactive-color "#414868"
        urgent-color   "#f7768e"
    }

    insert-hint {
        // Active color with 50% opacity
        color "#7aa2f780"
    }
}