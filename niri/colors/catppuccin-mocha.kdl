// Catppuccin Mocha Theme for Niri

layout {
    focus-ring {
        // Active: Mauve
        active-color   "#cba6f7"
        // Inactive: Base background
        inactive-color "#1e1e2e"
        // Urgent: Red
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#cba6f7"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    shadow {
        // Crust 色的冷调阴影，比纯黑更贴合 Base 背景
        color "#11111b99"
        // 非活动窗口更淡，靠浓淡区分焦点
        inactive-color "#11111b55"
    }

    tab-indicator {
        active-color   "#cba6f7"
        // Inactive Tab: 使用较柔和的表面层颜色
        inactive-color "#585b70"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        // Active color with 50% opacity
        color "#cba6f780"
    }
}
