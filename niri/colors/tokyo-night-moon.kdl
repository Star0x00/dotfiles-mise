// Tokyo Night Moon Theme for Niri

layout {
    focus-ring {
        // Active: Tokyo Night Blue
        active-color   "#82aaff"
        // Inactive: Moon Background (让非活动边框与背景融合)
        inactive-color "#222436"
        // Urgent: Red
        urgent-color   "#ff757f"
    }

    border {
        active-color   "#82aaff"
        inactive-color "#222436"
        urgent-color   "#ff757f"
    }

    shadow {
        // 用 Moon 的最深色做阴影，避免纯黑在蓝紫背景上发灰
        color "#1b1d2b99"
        // 非活动窗口更淡，靠浓淡区分焦点
        inactive-color "#1b1d2b55"
    }

    tab-indicator {
        active-color   "#82aaff"
        // Inactive Tab: 使用由深到浅的过渡色 (Overlay/Muted Blue)
        inactive-color "#444b6a"
        urgent-color   "#ff757f"
    }

    insert-hint {
        // Active color with 50% opacity (approx 80 in hex)
        color "#82aaff80"
    }
}
