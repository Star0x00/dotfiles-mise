// Workspaces
workspace "Browser"
workspace "Code"
workspace "Chat"
workspace "Game"

// -----------------------------------------------------------------------------
// Global Aesthetics (Apply to ALL windows)
// -----------------------------------------------------------------------------
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    open-floating false
    // background-effect {
    //     blur true
    //     xray false
    // }
    default-window-height { fixed 1388; }
    default-column-width { fixed 2540; }
}

blur {
    // passes = quality (more = smoother), offset = blur radius (more = stronger).
    // offset 3 was too weak to visibly blur; 5 passes keeps offset 6 smooth
    // and the 0.03 noise dithers away banding/ripples.
    passes 5
    offset 6
    noise 0.03
    saturation 0.95
}

// -----------------------------------------------------------------------------
// Layer Rules
// -----------------------------------------------------------------------------
// Set the overview wallpaper on the backdrop.
layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

layer-rule {
  match namespace="noctalia-bar-default$"
  background-effect {
    blur true
  }
}


// -----------------------------------------------------------------------------
// Floating Rules
// -----------------------------------------------------------------------------

// General Floating
window-rule {
    // System & UI Dialogs
    match title="^(file_progress)$"
    match title="^(confirm)$"
    match title="^(dialog)$"
    match title="^(download)$"
    match title="^(notification )$"
    match title="^(error)$"
    match title="^(splash)$"
    match title="^(nwg-look)$"
    match title="^(confirmreset)$"
    match title="^(Delete profile)$"
    match title="^File Operation Progress$"
    match title="^Confirm to replace files$"
    match title="^KDE Connect URL handler$"

    // File Pickers & Common Dialogs
    match title="^(Open File)(.*)$"
    match title="^(Select a File)(.*)$"
    match title="^(Choose wallpaper)(.*)$"
    match title="^(Open Folder)(.*)$"
    match title="^(Save As)(.*)$"
    match title="^(Library)(.*)$"
    match title="^(File Upload)(.*)$"

    // Integrations
    match title="^(hyprland-share-picker)$"
    match title="^(.*)-Google$"
    match title="^(.*)System Update$"
    match title="(.*) - Google (.*) - (.*)"

    // App Specific Floating
    match title="^satty$"
    match app-id="^xdm-app$"
    match app-id="^com.gabm.satty$"
    match app-id="^org.qbittorrent.qBittorrent$"
    match app-id="^org.videolan.VLC$"
    match app-id="^org.pulseaudio.pavucontrol$"
    match app-id="^net.davidotek.pupgui2$"
    match app-id="^com.github.th_ch.youtube_music$"
    match app-id="dev.noctalia.Noctalia"
    match app-id="io.github.Faugus.faugus-launcher"
    match app-id="com.github.wwmm.easyeffects"

    match app-id="firefox$" title="^Picture-in-Picture$"

    open-floating true
    default-column-width { proportion 0.75; }
    default-window-height { fixed 1000; }

}

// Floating with specific geometry
window-rule {
    match app-id="^QQ$"
    match title="^图片查看器$"
    match title="^群聊的聊天记录$"

    open-floating true
    default-column-width { proportion 0.75; }
    default-window-height { fixed 1000; }
    open-maximized false
}

window-rule {
    match app-id="^com.ayugram.desktop$" title="^Media viewer$"

    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { fixed 500; }
    open-maximized false
}

window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    match app-id="com.viber.Viber" title="^notificationtoasts_\\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// -----------------------------------------------------------------------------
// Window States (Fullscreen)
// -----------------------------------------------------------------------------

window-rule {
    match app-id="mpv$"
    open-fullscreen true
}

// -----------------------------------------------------------------------------
// Workspace Assignments & App Specifics
// -----------------------------------------------------------------------------

// Workspace: Browser
window-rule {
    match app-id="firefox-bin$"
    match app-id="org.mozilla.firefox$"
    match app-id="google-chrome$"
    open-on-workspace "browser"
    default-column-width { proportion 1.0; }
}

// Workspace: Code
window-rule {
    match app-id="kitty$"
    match app-id="foot$"
    match app-id="com.mitchellh.ghostty$"
    match app-id="neovide$"
    match app-id="emacs$"

    draw-border-with-background false
    open-floating false
    default-column-width { proportion 0.8; }
    open-on-workspace "Code"
    // Transparency + blur live here, not in ghostty: with ghostty's own
    // background-opacity < 1 the GTK window has no solid background, so the
    // frame where a new tab reparents the widget renders fully transparent
    // (the "flash"). An opaque window + compositor opacity/blur avoids it.
    opacity 0.78
    background-effect {
        blur true
        // Blur the wallpaper only (skip windows behind) so a terminal over a
        // browser doesn't smear its content.
        xray true
        // Override the global blur grain/saturation per window: a touch less
        // dither than global, neutral colors.
        noise 0.02
        saturation 1.0
    }
}

window-rule {
    match app-id="Postman$"
    match app-id="^obsidian$"
    open-on-workspace "Code"
}

// Workspace: Chat
window-rule {
    match app-id="^vesktop$"
    match app-id="^org.telegram.desktop$"
    match app-id="^com.ayugram.desktop$"

    default-column-width { proportion 0.5; }
    open-on-workspace "Chat"
}

window-rule {
  match app-id="^steam_app_0$"
  open-fullscreen true
  open-on-workspace "Game"
}
