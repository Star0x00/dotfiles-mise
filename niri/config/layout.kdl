/*
██╗      █████╗ ██╗   ██╗ ██████╗ ██╗   ██╗████████╗
██║     ██╔══██╗╚██╗ ██╔╝██╔═══██╗██║   ██║╚══██╔══╝
██║     ███████║ ╚████╔╝ ██║   ██║██║   ██║   ██║
██║     ██╔══██║  ╚██╔╝  ██║   ██║██║   ██║   ██║
███████╗██║  ██║   ██║   ╚██████╔╝╚██████╔╝   ██║
╚══════╝╚═╝  ╚═╝   ╚═╝    ╚═════╝  ╚═════╝    ╚═╝
*/
layout {
    // 只有一个窗口时自动居中显示
    always-center-single-column
    // 无缝边框风格：窗口之间只靠阴影和间距区分，间距 4 配合下面更紧的阴影
    gaps 4
    center-focused-column "never"
    default-column-display "tabbed"
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.2
        proportion 0.4
        proportion 0.5
        proportion 0.6
        proportion 0.8
        proportion 1.0
    }
    default-column-width {
        proportion 1.0
    }
    struts {
      left 4
      right 4
      top 4
      bottom 4
    }
    // 无边框、聚焦用阴影层次区分；圆角由 rules.kdl 的 geometry-corner-radius 控制
    focus-ring {
        off
    }
    border {
        off
    }
    shadow {
        on
        // 阴影只画在窗口周围（规则里 geometry-corner-radius 为 12，圆角不会被阴影填死）
        // 缝隙只有 4px，模糊半径压到 8 才不会整段被相邻窗口盖掉
        softness 8
        spread 0
        // 竖向偏移必须很小心：每多 1px，上下缝隙看起来就宽一截
        offset x=0 y=1
        // 颜色由主题文件 niri/colors/*.kdl 提供
    }

    tab-indicator {
        off
        width 5
        gap 7
        length total-proportion=0.5
        position "top"
        place-within-column
    }
}
