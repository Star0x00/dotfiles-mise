# Ghostty configuration
# Managed via dotfiles (symlinked by home-manager)

command = zsh
shell-integration-features = no-cursor, ssh-terminfo

theme = Catppuccin Mocha

# Font (monospace + CJK fallback), sized up for readability
# NOTE: ghostty's font-family does NOT split on comma — one family per key.
# CJK must go in font-family-fallback, not appended after the comma.
font-family = Iosevka Star Term
font-size = 16

# Appearance
# NOTE: keep this at 1 (opaque) so Ghostty keeps the GTK window's solid
# background. With opacity < 1 Ghostty removes that background, so the frame
# where a new tab reparents the terminal widget renders a fully transparent
# window -> the "flash" seen on new tabs (ghostty #8208 / #8835). Transparency
# + blur are applied by niri instead (window-rule in niri/config/rules.kdl).
background-opacity = 1

# Make GTK's own window background use the terminal colors. Without this the
# tab bar (which shows the window background) picks the GTK theme's grey, not
# Catppuccin, so it looks like a solid off-color strip.
window-theme = ghostty

cursor-style = block
cursor-style-blink = true
window-decoration = client
# Merge the titlebar and tab bar into one compact top strip ("tabs" style).
gtk-titlebar = true
gtk-titlebar-style = tabs
gtk-toolbar-style = flat
gtk-tabs-location = top
gtk-wide-tabs = true
gtk-custom-css = ~/.config/ghostty/gtk.css

# Behavior
cursor-click-to-move = false
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m
confirm-close-surface = false
copy-on-select = clipboard

# Keybindings
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+-=new_split:down

# Quick terminal (scratchpad) — centered, 70% size, overlay layer
quick-terminal-position = center
quick-terminal-size = 50%,70%
quick-terminal-screen = mouse
gtk-quick-terminal-layer = top
