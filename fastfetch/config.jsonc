{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "fedora_small",
    "color": { "1": "#89b4fa" },
    "padding": { "top": 1, "left": 2, "right": 8 }
  },
  "display": {
    "separator": "   ",
    "color": {
      "keys": "#89b4fa",
      "title": "#89b4fa",
      "separator": "#6c7086"
    },
    "key": { "width": 18 },
    "percent": { "type": 1 }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored} {cwd}"
    },
    { "type": "os", "key": "󰌽  System", "format": "{name} {version}" },
    { "type": "kernel", "key": "󰣇  Kernel", "format": "{sysname} {release}" },
    { "type": "cpu", "key": "󰻠  CPU", "format": "{name} @ {freq-max}" },
    {
      "type": "gpu",
      "key": "󰢮  GPU",
      "format": "{name} ({type})"
    },
    { "type": "shell", "key": "󰆍  Shell", "format": "{pretty-name}" },
    {
      "type": "uptime",
      "key": "󰅐  Uptime",
      "format": "{days} days, {hours} hours, {minutes} minutes"
    },
    { "type": "wm", "key": "󰍹  Desktop", "format": "{pretty-name} ({protocol-name})" },
    {
      "type": "memory",
      "key": "󰍛  Memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "󱥎  Storage /",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "disk",
      "key": "󱥎  Storage /var",
      "folders": "/var",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    { "type": "colors", "key": "󰏘  Colors", "symbol": "circle" }
  ]
}
